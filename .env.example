# ---------------------------------------------------------------------------
# Confirmely AI backend — environment template
# Copy to .env and fill in values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated CORS allowlist of browser origins, e.g. http://localhost:3000,https://app.example.com
FRONTEND_ORIGIN=http://localhost:5173

# Folder holding the JSON storage files (stores.json, customers.json, products.json,
# orders.json, ai-analytics.json). Missing files are created as empty arrays.
DATA_DIR=./data

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Business-owner account (single predefined account, no registration) ----
# Stable ID that owns every store created by this account. Changing it hides existing stores.
ADMIN_ID=owner_001
ADMIN_NAME=Store Owner
ADMIN_EMAIL=owner@confirmely.ai
# At least 8 characters. The placeholder is rejected when NODE_ENV=production.
ADMIN_PASSWORD=change-me

# --- Dashboard JWT ----------------------------------------------------------
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The placeholder is rejected when NODE_ENV=production.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
# Token lifetime, e.g. 15m, 8h, 7d
JWT_ACCESS_EXPIRES_IN=8h

# --- AI provider (AIGrid / OpenAI-compatible) ------------------------------
AI_PROVIDER=aigrid
# Obtain the base URL from the AIGrid dashboard. Must be a valid URL.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=Qwen/Qwen3.8-27B

# --- Telegram Bot -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Random secret used to validate webhook requests (X-Telegram-Bot-Api-Secret-Token header).
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Default store ID for Telegram orders. Must match a store in stores.json.
TELEGRAM_DEFAULT_STORE_ID=

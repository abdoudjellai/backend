# ---------------------------------------------------------------------------
# Confirmely AI backend — environment template
# Copy to .env and fill in values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core (validated at startup since Milestone 1) -------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated CORS allowlist of browser origins, e.g. http://localhost:3000,https://app.example.com
FRONTEND_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/confirmely_ai
# Optional: how long to wait for MongoDB at startup before failing (ms)
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Dashboard auth (used from Milestone 2 — not read yet) -----------------
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m

# --- n8n integration (used from Milestone 5 — not read yet) ----------------
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=
N8N_SERVICE_TOKEN=replace_with_long_random_secret
N8N_CALLBACK_SECRET=replace_with_long_random_secret

# --- Meta Messenger (used from Milestone 3/6 — not read yet) ---------------
# Not required for local development; mock providers will be used.
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=replace_with_random_verify_token
META_GRAPH_API_VERSION=
META_MESSENGER_PAGE_ID=
